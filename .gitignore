# ============================================================================
# DisasterCoord AI — .gitignore
# ============================================================================

# ---- Datasets ----
# Committed for reproducibility (under GitHub's 100 MB limit):
#   911.csv  -> reduced to the 3 columns the notebook reads (title/timeStamp/twp),
#               all 663,522 rows preserved so calibration is identical (~36 MB).
#   DisasterDeclarationsSummaries.csv -> FEMA declarations (~22 MB).
# NOT committed: the 264 MB PA file (never loaded by the notebook) and the
# full 117 MB 911 backup.
*.csv
!911.csv
!DisasterDeclarationsSummaries.csv
!images/results_table.csv
PublicAssistanceFundedProjectsDetails.csv
911_full.csv

# ---- Node / Vite (simulation) ----
node_modules/
simulation/node_modules/
simulation/dist/
dist/
*.local
.vite/

# ---- TypeScript build artefacts ----
*.tsbuildinfo
simulation/vite.config.js
simulation/vite.config.d.ts

# ---- Python ----
.venv/
venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# ---- LaTeX build artefacts ----
*.aux
*.log
*.out
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk
*.bbl
*.blg

# ---- OS / editor ----
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# ---- Logs ----
npm-debug.log*
yarn-debug.log*
yarn-error.log*
